# ==============================================================================
# SaaS_repo_demo — Omnichannel AI Sales & ERP B2B SaaS MVP
# Copy this file to `.env` for local development (never commit `.env` to git)
# ==============================================================================

# 1. Supabase PostgreSQL + pgvector (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saas_erp_mvp

# 2. Google Gemini API (Official `google-genai` SDK)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 3. Meta Graph API (v18.0+ Webhooks, Send API, Private Replies API)
META_VERIFY_TOKEN=saas-meta-webhook-verify-token
META_ACCESS_TOKEN=your-meta-page-access-token
META_API_VERSION=v18.0

# 4. SePay Sandbox API (Dynamic VietQR Generation & IPN Webhook Verification)
SEPAY_API_KEY=your-sepay-sandbox-api-key
SEPAY_ACCOUNT_NUMBER=0123456789
SEPAY_BANK_CODE=MB
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret

# 5. Telegram Bot API (Internal Staff Order Fulfillment Dispatch)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# 6. Nuxt 3 Frontend Configuration
NUXT_PUBLIC_API_BASE=http://localhost:8000

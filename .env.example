# ==============================================================================
# SaaS_repo_demo — Omnichannel AI Sales & ERP B2B SaaS MVP
# Copy this file to `.env` for local development (never commit `.env` to git)
# ==============================================================================

# 1. Supabase PostgreSQL + pgvector (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/saas_erp_mvp

# 2. Tenant Scoping, Demo Sandbox & Soft-Delete Retention
DEFAULT_TENANT_ID=default-tenant
DEMO_TENANT_ID=demo-sandbox
SOFT_DELETE_RETENTION_DAYS=365
RETENTION_CLEANUP_BATCH_SIZE=500

# 3. Google Gemini API (Official `google-genai` SDK)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_CHAT_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
GEMINI_EMBEDDING_MODEL=text-embedding-004

# 4. Meta Graph API (v18.0+ Webhooks, Send API, Private Replies API)
META_GRAPH_BASE_URL=https://graph.facebook.com
META_VERIFY_TOKEN=saas-meta-webhook-verify-token
META_ACCESS_TOKEN=your-meta-page-access-token
META_APP_SECRET=your-meta-app-secret
META_API_VERSION=v18.0

# 5. SePay Webhooks & Dynamic VietQR
SEPAY_QR_BASE_URL=https://qr.sepay.vn/img
SEPAY_PG_SANDBOX_URL=https://pay-sandbox.sepay.vn/v1/checkout/init
SEPAY_PG_PROD_URL=https://pay.sepay.vn/v1/checkout/init
SEPAY_API_KEY=your-sepay-sandbox-api-key
SEPAY_ACCOUNT_NUMBER=your-sepay-account-number
SEPAY_BANK_CODE=MB
SEPAY_WEBHOOK_SECRET=your-sepay-webhook-secret
SEPAY_AUTH_MODE=both
SEPAY_PAYMENT_PREFIX=DH
SEPAY_MEMO_PREFIX=
SEPAY_QR_TEMPLATE=compact
SEPAY_PG_MERCHANT_ID=your-sepay-pg-merchant-id
SEPAY_PG_SECRET_KEY=your-sepay-pg-secret-key
SEPAY_PG_IPN_SECRET=your-sepay-pg-ipn-secret
SEPAY_PG_ENV=sandbox

# 6. Telegram Bot API (Internal Staff Order Fulfillment Dispatch & Demo Sandbox)
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
DEMO_TELEGRAM_CHAT_ID=

# 7. Application Environment, Auth Tokens & Strict CORS
APP_ENV=development
API_TOKEN_SECRET=replace-with-at-least-32-char-random-secret-key
API_TOKEN_ISSUER=saas-erp-backend
API_TOKEN_AUDIENCE=saas-erp-api
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
DEMO_TOKEN_TTL_SECONDS=1800
ORDER_PAYMENT_TTL_SECONDS=1800
AUTH_RATE_LIMIT_PER_MINUTE=20
DEMO_NOTIFY_RATE_LIMIT_PER_MINUTE=10
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://saa-s-repo-demo.vercel.app

# 8. Nuxt 3 Frontend Configuration
NUXT_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_API_BASE_URL=http://localhost:8000
NUXT_PUBLIC_API_BASE=http://localhost:8000
